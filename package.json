  "bugs": {
    "url": "https://github.com/matheusnogueiraQA/Desafio-Accenture/issues"
  },
  "homepage": "https://github.com/matheusnogueiraQA/Desafio-Accenture#readme",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@faker-js/faker": "^10.6.0",
    "cypress": "^16.2.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "cypress-on-fix": "^1.1.0",
    "puppeteer-core": "^25.15.0"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/[filepath].js",
      "cypress/e2e/[filepart].js",
      "cypress/support/step_definitions/**/*.js"
    ]
  }
