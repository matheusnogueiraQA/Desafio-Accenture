  "main": "index.js",
  "scripts": {
    "cy:run": "cypress run",
    "cy:open": "cypress open",
    "cy:api": "cypress run --spec \"cypress/e2e/api/**/*.feature\"",
    "cy:frontend": "cypress run --spec \"cypress/e2e/frontend/**/*.feature\"",
    "cy:browser-windows": "cypress run --browser chrome --headed --spec \"cypress/e2e/frontend/browser-windows/browser-windows.feature\"",
    "cy:report": "cypress run"
  },
  "repository": {
    "type": "git",
